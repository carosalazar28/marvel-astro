---
import Layout from '../layouts/Layout.astro';
import CountdownTimer from '../components/CountdownTimer';
import PreparationTracker from '../components/PreparationTracker';
import premiereHero from '../assets/premiere-hero-v1.jpg';
import preparationRoute from '../data/preparation-route.json';
import { parsePreparationRoute } from '../utils/preparation-route';

const targetPremiere = {
	title: 'Avengers: Doomsday',
	targetDate: '2026-12-18T00:00:00',
	targetDateLabel: '18 de diciembre de 2026',
};

const route = parsePreparationRoute(preparationRoute, new Date());
---

<Layout>
	<main>
		<section class="premieres" aria-label="Meta de estreno">
			<CountdownTimer client:load {...targetPremiere} imageSrc={premiereHero.src} subtitle="La culminación de una era" isCurrent />
		</section>

		<PreparationTracker client:load items={route.items} issues={route.issues} />
	</main>
</Layout>

<style>
	main { width: min(100%, 1280px); margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem) clamp(1rem, 4vw, 3rem) 4rem; }
	.premieres { margin-bottom: clamp(3.5rem, 8vw, 6rem); }
</style>
